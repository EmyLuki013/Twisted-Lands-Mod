{
	"schemaVersion": 1,
	"id": "twisted",
	"version": "${version}",
	"name": "Twisted Lands",
	"description": "A fantasy mod, full of adventure, exploration, challenges, and magic. Some features are based on and inspired by the old Orespawn mod.",
	"authors": [
		"Emy Lukie(TheLuke013)",
		"Berg210",
		"Tofuuu",
		"Torrelexado"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/twisted/icon.png",
	"environment": "*",
	"accessWidener": "twisted.accesswidener",
	"entrypoints": {
		"main": [
			"com.twistedteam.twistedlands.TwistedLands"
		],
		"client": [
			"com.twistedteam.twistedlands.client.TwistedLandsClient"
		]
	},
	"mixins": [
		"twisted.mixins.json",
		{
			"config": "twisted.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*",
		"geckolib": ">=4.8.4",
		"smartbrainlib": ">=1.15"
	}
}